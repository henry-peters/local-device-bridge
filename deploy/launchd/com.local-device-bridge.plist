<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.local-device-bridge</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/local-device-bridge</string><string>daemon</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/tmp/local-device-bridge.log</string>
  <key>StandardErrorPath</key><string>/tmp/local-device-bridge.err</string>
</dict></plist>
